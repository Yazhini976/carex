# ==============================================================================
# Multi-stage Dockerfile for CAREX Spring Boot Backend
# ==============================================================================

# Stage 1: Build JAR using Maven
FROM maven:3.9.6-eclipse-temurin-17-alpine AS builder
WORKDIR /build

COPY backend/pom.xml .
RUN mvn dependency:go-offline -B

COPY backend/src ./src
RUN mvn clean package -DskipTests -B

# Stage 2: Minimal Production JRE Runtime
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Security: Create non-root user
RUN addgroup -S carexgroup && adduser -S carexuser -G carexgroup

COPY --from=builder /build/target/carex-backend-*.jar app.jar
RUN chown -R carexuser:carexgroup /app

USER carexuser

EXPOSE 8080 10000

ENTRYPOINT ["sh", "-c", "java -Dserver.port=${PORT:-8080} -Djava.security.egd=file:/dev/./urandom -jar app.jar"]
