# ==============================================================================
# CAREX Platform Environment Configuration Template
# Copy this file to .env and provide your local/production credentials.
# ==============================================================================

# Database Configuration
POSTGRES_DB=carex
POSTGRES_USER=carex
POSTGRES_PASSWORD=carex
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# JWT Security
JWT_SECRET=carexSecretKeyMustBeAtLeast256BitsLongForHMACSHA256Security1234567890
JWT_EXPIRATION=86400000

# Mail & SMTP Configuration
# Set CAREX_EMAIL_ENABLED=true to send real transactional emails (Gmail, SendGrid, Mailtrap, AWS SES)
CAREX_EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@carex.com

# CAREX Notification Engine & Reminder Scheduler
CAREX_REMINDER_MINUTES_BEFORE=30
CAREX_REMINDER_SCHEDULER_ENABLED=true
CAREX_EMAIL_MAX_RETRIES=3

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8080/api
